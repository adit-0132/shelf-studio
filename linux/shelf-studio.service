# Template: linux/install.sh fills in the @...@ values for this clone.
[Unit]
Description=Shelf Studio local image workspace
After=network.target

[Service]
Type=simple
WorkingDirectory=@APP_DIR@
ExecStart=@NODE@ @APP_DIR@/src/server.mjs
Environment=CODEX_BIN=@CODEX@
Environment=PATH=@PATH@
Restart=on-failure
RestartSec=3
TimeoutStopSec=15

[Install]
WantedBy=default.target
